# Database Configuration
# Include the DATABASE NAME (the /sriramjewellery path segment below). The
# string Atlas gives you under "Connect" ends at the host, and mongoose then
# writes every collection into a database literally called "test".
# Unset in development, the server falls back to an in-memory MongoDB and seeds
# it on each start — handy for a quick local run, discarded on restart.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sriramjewellery?retryWrites=true&w=majority"

# JWT Authentication
# IMPORTANT: Generate a strong random secret (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET="your_jwt_secret_here"

# Environment
NODE_ENV="development"

# Customer sign-in is by EMAIL CODE. Codes are emailed through Brevo.
# Without BREVO_API_KEY + EMAIL_FROM: in development (NODE_ENV=development)
# codes are printed to the API console; anywhere else the server logs FATAL and
# /api/auth/otp/request returns 503. See README "Before going live".
# Brevo → SMTP & API → API Keys (a v3 key). Free tier: 300 emails/day.
BREVO_API_KEY=""
# On your verified Brevo sender domain — never a gmail.com / webmail address.
EMAIL_FROM="Sri Ram Jewellery <signin@mail.your-domain.com>"
EMAIL_REPLY_TO=""
# EMAIL_PROVIDER="brevo"

# Test sign-in code. ALLOW_TEST_OTP="true" (exact string) accepts the fixed
# code 123456 ONLY for the addresses listed in TEST_OTP_EMAILS — an empty list
# means no address. Refused in any production environment. Leave both UNSET in
# production.
ALLOW_TEST_OTP=""
TEST_OTP_EMAILS=""

# Absolute public origin of the site, https in production. Razorpay renders the
# merchant logo inside its own https iframe, so a relative path cannot work.
# Also used for links in owner WhatsApp alerts (server reads PUBLIC_SITE_URL).
VITE_PUBLIC_SITE_URL="https://your-domain.com"
PUBLIC_SITE_URL="https://your-domain.com"

# ─── Local ports ─────────────────────────────────────────────────────────────
# The API listens on PORT (default 5000) and Vite proxies /api to
# VITE_API_PROXY_TARGET. On macOS, port 5000 is taken by the AirPlay Receiver
# (System Settings → General → AirDrop & Handoff), so set both to 5001 there.
PORT="5000"
VITE_API_PROXY_TARGET="http://localhost:5000"

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,https://sriramjewellery.com"

# Admin Credentials (used during database seeding)
# Set a strong, unique value. Seeding is skipped if ADMIN_PASSWORD is unset —
# never commit a real password here, this file is public.
ADMIN_PASSWORD="set_a_strong_admin_password"
TEST_USER_PASSWORD="set_a_strong_test_password"

# Razorpay Payment Integration (Optional)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_HERE"
RAZORPAY_KEY_SECRET="YOUR_SECRET_HERE"
# Created in the Razorpay dashboard (Settings → Webhooks) when you add a webhook
# subscribed to `payment.captured`, pointed at
# https://<your-domain>/api/payment/webhook. This is a SEPARATE value from
# RAZORPAY_KEY_SECRET. Without it the webhook refuses every request with a 503
# and orders stay pending whenever the customer's browser never completes the
# verify call.
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET_HERE"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# How long an unpaid card order may hold its stock before the sweeper takes it
# back and marks the order expired. COD orders are never swept. Default 30.
STOCK_RELEASE_MINUTES="30"
# Shared secret for /api/cron/* . The schedule is NOT on Vercel: the Hobby plan
# allows one cron run per day, and the stale-reservation sweep needs to run far
# more often than that, so `crons` was removed from vercel.json and an external
# scheduler (cron-job.org) calls the endpoint instead.
# Send it as `Authorization: Bearer $CRON_SECRET` (preferred) or `?secret=...`
# (fallback for schedulers that cannot set headers — note that query strings end
# up in access logs). Set the same value here and in the Vercel dashboard.
# Generate with: openssl rand -hex 32
# Without it the cron endpoints fail closed (503) rather than sitting public.
CRON_SECRET="generate_a_long_random_string"

# WhatsApp Cloud API (Required for Quote-Only notifications)
# Get from Meta Business Suite: https://business.facebook.com/
WHATSAPP_TOKEN="your_meta_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_here"
ADMIN_WHATSAPP_NUMBER="919876543210" # Must include country code without '+'

# WhatsApp chat link for customers (the floating button, "Ask on WhatsApp").
# Build-time: Vite inlines VITE_* into the bundle, so changing these needs a
# redeploy. Separate from ADMIN_WHATSAPP_NUMBER above (the owner's alerts).
# !! The number below is a TESTING number (a personal phone). Change it to the
# !! shop's WhatsApp number before launch.
# International format, digits only (a leading + is ignored).
VITE_WHATSAPP_NUMBER="919345548984"
VITE_WHATSAPP_GREETING="Hi, I'd like to know more about your jewellery."

# Cloudinary signed API access (server-only — NEVER prefix with VITE_, never
# expose to the client). This is the one the admin image upload actually uses:
# the browser calls /api/admin/cloudinary-signature and the server returns the
# signature, api key and cloud name. Without it that route returns 503 and
# admin image uploads fail; everything else keeps working.
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# Unsigned direct-from-browser uploads. OPTIONAL — no longer used by the upload
# path above. Only set these if you reintroduce a preset-based upload.
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
VITE_CLOUDINARY_UPLOAD_PRESET="your_upload_preset_here"
